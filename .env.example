# Copy to .env. Only OPENAI_API_KEY is required (vision default + chat + speech-to-text).
OPENAI_API_KEY=
# Optional vision backends selectable in the console (see NOTES.md for measured accuracy/latency):
GEMINI_API_KEY=
MOONDREAM_API_KEY=
GROK_API_KEY=        # xAI (also accepted as XAI_API_KEY)
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Optional overrides
# PRESS_MODELS=gpt-5.4-mini,gpt-4.1-mini   # primary, fallback
# PRESS_MODE=primary                       # or race
# CHAT_MODEL=gpt-5.4-mini
# STT_MODEL=gpt-4o-mini-transcribe
# PORT=8787
